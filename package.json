{
  "name": "rune-panel",
  "version": "0.1.0",
  "private": true,
  "description": "An all-in-one Old School RuneScape desktop tool",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "sync:titles": "electron out/main/index.js --sync-titles",
    "crawl": "electron out/main/index.js --crawl"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "cheerio": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.3.0",
    "electron-vite": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "zustand": "^5.0.2"
  }
}
